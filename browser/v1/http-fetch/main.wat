(module
  (import "wasix_http_client_v1" "client::new" (func $new (param i32)))
  (import "wasix_http_client_v1" "client::send" (func $send (param i32 i32)))
  (import "canonical_abi" "resource_drop_client" (func $drop (param i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $env (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 4)
  (global $next (mut i32) (i32.const 16384))
  (global $base (mut i32) (i32.const 0))
  (global $length (mut i32) (i32.const 0))
  (func (export "canonical_abi_realloc") (param i32 i32) (param $align i32) (param $len i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
    (global.set $next (i32.add (local.get $p) (local.get $len))) (local.get $p))
  (data (i32.const 1024) "/binary\00/status\00/cors-denied\00/reset\00/echo\00/slow\00")
  (data (i32.const 1100) "\00\80\ff")
  (func $check (param $condition i32) (param $code i32)
    (if (i32.eqz (local.get $condition)) (then (call $exit (local.get $code)) unreachable)))
  (func $request (param $path i32) (local $n i32)
    (memory.copy (i32.const 512) (global.get $base) (global.get $length))
    (loop $copy
      (i32.store8 (i32.add (i32.add (i32.const 512) (global.get $length)) (local.get $n)) (i32.load8_u (i32.add (local.get $path) (local.get $n))))
      (if (i32.load8_u (i32.add (local.get $path) (local.get $n))) (then (local.set $n (i32.add (local.get $n) (i32.const 1))) (br $copy))))
    (i32.store (i32.const 132) (i32.const 512))
    (i32.store (i32.const 136) (i32.add (global.get $length) (local.get $n)))
    (call $send (i32.const 128) (i32.const 256)))
  (func (export "_start") (local $i i32) (local $p i32)
    (drop (call $env (i32.const 1536) (i32.const 2048)))
    (block $found (loop $scan
      (local.set $p (i32.load (i32.add (i32.const 1536) (local.get $i))))
      (call $check (local.get $p) (i32.const 1))
      ;; HTTP_BASE= (all ten bytes checked).
      (if (i32.and (i64.eq (i64.load (local.get $p)) (i64.const 0x5341425f50545448)) (i32.eq (i32.load16_u offset=8 (local.get $p)) (i32.const 0x3d45)))
        (then (global.set $base (i32.add (local.get $p) (i32.const 10))) (br $found)))
      (local.set $i (i32.add (local.get $i) (i32.const 4))) (br $scan)))
    (loop $len (if (i32.load8_u (i32.add (global.get $base) (global.get $length)))
      (then (global.set $length (i32.add (global.get $length) (i32.const 1))) (br $len))))
    (call $new (i32.const 64)) (call $check (i32.eqz (i32.load8_u (i32.const 64))) (i32.const 2))
    (i32.store (i32.const 128) (i32.load (i32.const 68)))
    (call $request (i32.const 1024))
    (call $check (i32.eqz (i32.load8_u (i32.const 256))) (i32.const 3))
    (call $check (i32.eq (i32.load16_u (i32.const 260)) (i32.const 201)) (i32.const 4))
    (call $check (i32.eq (i32.load (i32.const 280)) (i32.const 3)) (i32.const 5))
    (call $check (i32.eq (i32.load16_u offset=1 (i32.load (i32.const 276))) (i32.const 65408)) (i32.const 6))
    ;; HTTP error status is still a successful transport response.
    (call $request (i32.const 1032))
    (call $check (i32.eqz (i32.load8_u (i32.const 256))) (i32.const 7))
    (call $check (i32.eq (i32.load16_u (i32.const 260)) (i32.const 500)) (i32.const 8))
    (call $request (i32.const 1040))
    (call $check (i32.eq (i32.load8_u (i32.const 256)) (i32.const 1)) (i32.const 9))
    (call $request (i32.const 1053))
    (call $check (i32.eq (i32.load8_u (i32.const 256)) (i32.const 1)) (i32.const 10))
    ;; Binary POST crosses the worker bridge unchanged.
    (i32.store8 (i32.const 140) (i32.const 2))
    (i32.store8 (i32.const 160) (i32.const 1))
    (i32.store (i32.const 168) (i32.const 1100)) (i32.store (i32.const 172) (i32.const 3))
    (call $request (i32.const 1060))
    (call $check (i32.eqz (i32.load8_u (i32.const 256))) (i32.const 11))
    (call $check (i32.eq (i32.load16_u offset=1 (i32.load (i32.const 276))) (i32.const 65408)) (i32.const 12))
    ;; Timeout aborts the pending fetch and returns the canonical expected<string> error.
    (i32.store8 (i32.const 140) (i32.const 0)) (i32.store8 (i32.const 160) (i32.const 0))
    (i32.store8 (i32.const 176) (i32.const 1)) (i32.store (i32.const 180) (i32.const 25))
    (call $request (i32.const 1066))
    (call $check (i32.eq (i32.load8_u (i32.const 256)) (i32.const 1)) (i32.const 13))
    (call $drop (i32.load (i32.const 128))) (call $exit (i32.const 0))))

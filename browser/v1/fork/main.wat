(module
  (import "wasix_32v1" "proc_fork" (func $fork (param i32 i32) (result i32)))
  (import "wasix_32v1" "proc_join" (func $join (param i32 i32 i32) (result i32)))
  (import "wasix_32v1" "proc_exit2" (func $exit (param i32)))
  (memory (export "memory") 1 2048)
  (global (export "__stack_pointer") (mut i32) (i32.const 32768))
  (func (export "_start")
    (i32.store (i32.const 200) (i32.const 7))
    (if (call $fork (i32.const 1) (i32.const 100)) (then (call $exit (i32.const 1))))
    (if (i32.eqz (i32.load (i32.const 100)))
      (then
        (i32.store (i32.const 200) (i32.const 9))
        (call $exit (i32.const 3))))
    (i32.store8 (i32.const 256) (i32.const 1))
    (i32.store (i32.const 260) (i32.load (i32.const 100)))
    (if (call $join (i32.const 256) (i32.const 0) (i32.const 272))
      (then (call $exit (i32.const 2))))
    (if (i32.ne (i32.load16_u (i32.const 274)) (i32.const 3))
      (then (call $exit (i32.const 4))))
    (if (i32.ne (i32.load (i32.const 200)) (i32.const 7))
      (then (call $exit (i32.const 5))))
    (call $exit (i32.const 0))))
